GEMINI_API_KEY=tu_clave_aqui
SECRET_KEY=tu_secreto_para_jwt
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Para usar PostgreSQL, cambia esta variable por la cadena de conexión correspondiente.
# Ejemplo PostgreSQL: postgresql://usuario:contraseña@localhost/nombre_bd
# Si no se define o está vacía, usará SQLite (sqlite:///./llamaindex.db) por defecto.
DATABASE_URL=sqlite:///./llamaindex.db

# --- Configuraciones del sistema ---
MAX_FILE_SIZE_MB=15
MAX_FILES_PER_MESSAGE=3
MAX_PAGES_PER_DOC=50
MIN_CHARS_PER_PAGE=100
MAX_MESSAGE_CHARS=4000

# --- Contexto y RAG ---
CONTEXT_WINDOW_MESSAGES=12
SUMMARY_TRIGGER_MESSAGES=20
RAG_TOP_K=6
