# =============================================================================
# Git Ignore - Sistema de Auditoría Documental TDR + CV
# =============================================================================

# --- 1. Variables de Entorno y Claves Secretas (CRÍTICO) ---
.env
*.env
!.env.example

# --- 2. Base de Datos SQLite Local y Migraciones Temporales ---
*.db
*.sqlite
*.sqlite3
llamaindex.db

# --- 3. Archivos PDF Subidos por Usuarios (Privacidad de Expedientes) ---
data/uploads/*
!data/uploads/.gitkeep

# --- 4. Python, Caché y Entornos Virtuales ---
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
env/
ENV/
.pytest_cache/
*.egg-info/

# --- 5. Frontend (React / Vite / Node.js) ---
frontend/node_modules/
frontend/dist/
frontend/dist-ssr/
frontend/*.local
node_modules/
dist/

# --- 6. Logs y Archivos Temporales de Extracción ---
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
temp_*.pdf

# --- 7. Editores y Sistema Operativo ---
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
Thumbs.db
*.swp
*.swo

